<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" http-equiv="Content-Security-Policy" content="
  default-src 'self' 'unsafe-inline'; 
  script-src 'self' 'unsafe-inline'; 
  style-src 'self' 'unsafe-inline'; 
  media-src 'self' https://*.max.ru https://*.okcdn.ru https://*.oneme.ru https://*.vkuser.net; 
  img-src   'self' https://*.max.ru https://*.okcdn.ru https://*.oneme.ru https://vkuser.net data: https:;
"/>
<style>
body {
  margin: 0;
  padding: 0;
  height: 100%; 
  width: 100%;
  overflow: hidden; 
  display: flex; 
  flex-direction: column; 
  background: #25262d;
//  background: rgba(37, 38, 45, 0.7)
//  backdrop-filter: blur(15px);
//  border: 1px solid rgba(90, 90, 90, 0.1); /* тонкая рамка */
//  border-radius: 12px 12px 0 0; /* скругление углов */
//  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "Roboto", system-ui, Avenir, Helvetica, Arial, sans-serif;
}

:root {
  --hover-color: rgba(255, 255, 255, 0.1);
  --close-hover: #e81123;
}

#title-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 30px;
  color: white;
  font-family: "Segoe UI", sans-serif;
  font-size: 15px;
  font-weight: 400;
  background: #25262d;
//  background: rgba(37, 38, 45, 0.7)
//  backdrop-filter: blur(15px);
//  border: 1px solid rgba(90, 90, 90, 0.1); /* тонкая рамка */
//  border-radius: 12px 12px 0 0; /* скругление углов */
//  overflow: hidden;
//  padding-left: 4px;
//  user-select: none;
}

#title-text {
  padding-left: 4px;
}
.drag-region {
  flex-grow: 1;
  height: 100%;
  display: flex;
  align-items: center;
  padding-left: 12px;
  -webkit-app-region: drag;
}

#titlebar {
  display: flex;
  justify-content: space-between;
  height: 32px;
  background: #fff;
  -webkit-app-region: drag;
}

.window-controls {
  display: flex;
  -webkit-app-region: no-drag;
  transition: opacity 0.5s ease-in-out; /* Плавное исчезновение */
  opacity: 1;
}

.window-controls.hidden {
  opacity: 0;
  pointer-events: none; /* Чтобы нельзя было нажать на невидимые кнопки */
}

.control-btn {
  width: 46px;
  height: 30px;
  padding: 0;
  display: flex; 
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: #f0f0f0;
  outline: none;
  transition: background 0.2s;
}

.control-btn svg {
  flex-shrink: 0;
//  display: inline-block;
}

.window-controls.inactive .control-btn {
  color: #909090;
}
.control-btn:hover {
  background: var(--hover-color);
}

.control-btn.close-btn:hover {
  background: var(--close-hover) !important;
}
</style>
</head>
<body>
 <div id="title-bar">
  <div class="drag-region">
  <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="16px" height="16px" viewBox="0 0 32 32" version="1.1">
   <defs>
   <linearGradient id="myGradient" x1="0%" y1="0%" x2="100%" y2="100%">
   <stop offset="0%" stop-color="#4c34e7" />
   <stop offset="100%" stop-color="#9750db" />
   </linearGradient>
   </defs>
   <rect x="1" y="1" width="30" height="30" rx="5" fill="url(#myGradient)"/>
   <g id="surface1">
   <path fill="#fff" fill-rule="evenodd"
 d="M 16.261719 28.105469 C 13.863281 28.105469 12.746094 27.757812 10.808594 26.355469 C 9.582031 27.929688 5.699219 29.164062 5.527344 27.054688 C 5.527344 25.472656 5.179688 24.136719 4.78125 22.675781 C 4.308594 20.875 3.769531 18.875 3.769531 15.972656 C 3.769531 9.039062 9.460938 3.824219 16.199219 3.824219 C 22.945312 3.824219 28.230469 9.296875 28.230469 16.035156 C 28.25 22.671875 22.898438 28.070312 16.261719 28.105469 Z M 16.363281 9.816406 C 13.078125 9.644531 10.523438 11.917969 9.957031 15.480469 C 9.488281 18.429688 10.316406 22.019531 11.023438 22.207031 C 11.363281 22.289062 12.214844 21.601562 12.746094 21.070312 C 13.625 21.675781 14.648438 22.042969 15.714844 22.125 C 19.113281 22.289062 22.019531 19.699219 22.25 16.304688 C 22.382812 12.898438 19.761719 10.015625 16.363281 9.820312 Z M 16.363281 9.816406 "/>
   </g>
  </svg>
  <span id="title-text">MAX</span>
  </div>
  <div class="window-controls" id="mainapp">
	<button class="control-btn" id="min-btn">
	  <svg width="46" height="30" viewBox="0 0 46 32" fill="none" xmlns="http://www.w3.org">
		<path d="M18 17H28" stroke="currentColor" stroke-width="1"/>
	  </svg>
	</button>

	<button class="control-btn" id="max-btn">
	  <svg class="maximize" width="46" height="30"  viewBox="0 0 46 32" fill="none" xmlns="http://www.w3.org" style="display:none">
		  <rect x="18" y="11.5" width="9" height="9" fill="none" stroke="currentColor"/>
	  </svg>
	  <svg class="restore"  width="46" height="30"  viewBox="0 0 46 32" fill="none" xmlns="http://www.w3.org" style="display:inline-block">
		 <path d="M18 13.5h6v6h-6z M20 11.5h7v6" fill="none" stroke="currentColor"/>
	  </svg>
	</button>

	<button class="control-btn close-btn" id="close-btn">
	  <svg width="46" height="30"  viewBox="0 0 46 32" fill="none" xmlns="http://www.w3.org">
		  <path d="M18 11L28 21M28 11L18 21" stroke="currentColor" stroke-width="1"/>
	  </svg>
	</button>
  </div>
 </div>
 <script>
	const { ipcRenderer } = require('electron');
	const controls = document.querySelector('.window-controls');
	const titleBar = document.getElementById('title-bar');
	const maxBtn = document.getElementById('max-btn');
	const iconMax = maxBtn.querySelector('.maximize');
	const iconRes = maxBtn.querySelector('.restore');
	const header = document.getElementById('title-bar');

//	window.focus();

	document.getElementById('min-btn').onclick = () => ipcRenderer.send('win-min');
	document.getElementById('close-btn').onclick = () => ipcRenderer.send('win-close');
	document.getElementById('max-btn').onclick = () => ipcRenderer.send('win-max-res');
	header.addEventListener('dblclick', (event) => {
		event.preventDefault;
		ipcRenderer.send('win-max-res'); 
	});

/*	window.addEventListener('blur', () => {
		console.log("unfocused");
		document.getElementById('mainapp').classList.add('inactive');
	});

	window.addEventListener('focus', () => {
		console.log("focused");
		document.getElementById('mainapp').classList.remove('inactive');
	});//*/

	ipcRenderer.on('app-focus-change', (event, isFocused) => {
		if (isFocused) {
			document.getElementById('mainapp').classList.remove('inactive');
		} else {
			document.getElementById('mainapp').classList.add('inactive');
		}
	});

	ipcRenderer.on('win-status', (event, isFullScreen) => {
		if (isFullScreen) {
			iconMax.style.display = 'none';
			iconRes.style.display = 'inline-block';
		} else {
			iconMax.style.display = 'inline-block';
			iconRes.style.display = 'none';
		}
	});
 </script>
</body>
</html>